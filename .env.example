# ---------------------------------------------------------------------------
# Shopify Storefront API
# ---------------------------------------------------------------------------
# Domein van je Shopify-store, ZONDER https:// (bv. mijn-shop.myshopify.com).
SHOPIFY_STORE_DOMAIN=

# Storefront API access token (Shopify Admin > Settings > Apps > Develop apps
# > jouw app > Storefront API > Install). Begint meestal met "shpat_" of is
# een lange hex-string. Dit is een PUBLIEKE storefront token (geen admin token).
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Storefront API-versie. Verhoog wanneer je naar een nieuwere versie migreert.
SHOPIFY_API_VERSION=2025-01

# ---------------------------------------------------------------------------
# Shopify Admin API (admin-paneel — schrijftoegang, GEHEIM)
# ---------------------------------------------------------------------------
# Admin API access token van een Shopify CUSTOM APP (Admin > Settings > Apps >
# Develop apps > jouw app > Admin API > Install). Begint met "shpat_".
# Scopes: read_products, write_products, read_files, write_files, read_inventory.
# LET OP: dit is een KRACHTIG geheim — enkel server-side, nooit in de browser.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Admin API-versie (mag onafhankelijk van de Storefront-versie evolueren).
SHOPIFY_ADMIN_API_VERSION=2025-01

# De API secret key van diezelfde custom app — gebruikt om Shopify-webhooks
# te verifiëren (HMAC). Admin > Apps > jouw app > API credentials.
SHOPIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Database (admin-paneel — Postgres, enkel beheermetadata)
# ---------------------------------------------------------------------------
# Lokaal (next dev op de host):   postgres://pawhaus:pawhaus@127.0.0.1:5432/pawhaus
# In Docker (docker-compose):     postgres://pawhaus:pawhaus@postgres:5432/pawhaus
DATABASE_URL=postgres://pawhaus:pawhaus@127.0.0.1:5432/pawhaus

# Credentials voor de Postgres-container (zie docker-compose.yml).
POSTGRES_USER=pawhaus
POSTGRES_PASSWORD=pawhaus
POSTGRES_DB=pawhaus

# ---------------------------------------------------------------------------
# AI (admin-paneel — tekstoptimalisatie via Google Gemini)
# ---------------------------------------------------------------------------
# Google Gemini API-key voor de AI-tekstoptimizer (officiële @google/genai SDK).
# Haal er een op via https://aistudio.google.com/apikey
# De AI maakt enkel concepten; publiceren naar Shopify gebeurt pas na goedkeuring.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Volledige publieke URL van de webshop (voor SEO / canonical / OG-tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Opmerking
# ---------------------------------------------------------------------------
# Zolang SHOPIFY_STOREFRONT_ACCESS_TOKEN leeg is, draait de webshop automatisch
# op MOCK-DATA, zodat je de volledige UI kunt bekijken zonder Shopify-store.
